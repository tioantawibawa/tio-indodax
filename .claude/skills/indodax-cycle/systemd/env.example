# indodax-skills environment for the systemd USER timers. Installed at ~/.config/indodax-skills/env (chmod 600).
# Never commit the real file. Never put INDODAX_LIVE=true here: the automatic cycle refuses to run when it is set.

INDODAX_STATE_DIR=%STATE%

# Telegram. Without it the cycle still runs (notification skipped), but the alerts/report timers show
# "failed" whenever there is something to send — that is intentional, so a missing token is noticed.
# Use a separate bot/chat from the live agent so the two are never confused.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
