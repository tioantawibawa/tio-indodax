# Copy to .env, fill in, then: chmod 600 .env
# NEVER commit .env. NEVER paste its contents into chat/logs.

# backtest | paper | live
MODE=paper
# config/settings.yaml = real account; config/settings.demo.yaml = https://demo-indodax.com
AGENT_SETTINGS=config/settings.yaml
# Live mode only starts when this is exactly: I_UNDERSTAND_THE_RISK
LIVE_CONFIRM=

# Indodax API key: permissions view + trade ONLY (no withdraw), IP-whitelisted to the VPS.
INDODAX_API_KEY=
INDODAX_API_SECRET=
# Optional: dedicated Trade API 2.0 key (see docs/indodax_api_notes.md §10 Q1)
INDODAX_V2_API_KEY=
INDODAX_V2_API_SECRET=

TELEGRAM_BOT_TOKEN=
# Send /start to your bot, then: python -m scripts.telegram_chat_id
TELEGRAM_CHAT_ID=

# Optional LLM analyst
LLM_ENABLED=false
ANTHROPIC_API_KEY=
